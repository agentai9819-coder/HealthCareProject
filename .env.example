# Environment Configuration
# See packages/config for shared validation schema

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
# Local: postgresql://postgres:postgres@localhost:5432/healthcare
# Cloud (Neon/Supabase/AWS RDS): postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare

# Authentication
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=a_very_secure_long_secret_key_minimum_32_characters_long_for_sessions

# CORS & Frontend
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1