{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "home-healthcare-types": ["../../packages/types/dist"],
      "home-healthcare-validation": ["../../packages/validation/dist"],
      "home-healthcare-config": ["../../packages/config/dist"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}